{
  "name": "agent-red",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "AI red team workbench for scoped testing and evidence-driven reporting.",
  "license": "MIT",
  "keywords": [
    "authorized-security",
    "ai-security",
    "pentest",
    "bug-bounty",
    "red-team",
    "evidence",
    "typescript"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/*.integration.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/ws": "^8.18.1",
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  }
}
